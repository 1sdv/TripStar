# Docker Compose 配置模板
# 复制为根目录 .env 后再执行：docker-compose up -d --build

# ========== LLM（兼容 OpenAI 格式） ==========
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL_ID=your_model
LLM_TIMEOUT=600

# ========== 高德地图 ==========
# 后端 REST 服务 Key：地理编码、POI、天气、路线等
VITE_AMAP_WEB_KEY=your_amap_web_service_key
# 前端 Web端(JS API) Key：地图渲染
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key
# 前端 Web端(JS API) 安全密钥 JSCode：构建期注入 index.html
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code

# ========== 小红书（可选数据源） ==========
# 总开关，默认 false。
# 景点图片默认走高德官方图库；仅当高德取不到图且此处为 true 时，才回退到小红书。
# 小红书依赖登录 Cookie 与混淆 JS 签名，稳定性和合规性都不如官方 API，不建议默认开启。
# 不填 Cookie 也能运行：景点数据会自动降级到本地知识库。
ENABLE_XHS=false
XHS_COOKIE="a1=xxx; web_session=xxx; webId=xxx"

# ========== RAG 本地知识库（可选，推荐） ==========
# 用途：景点数据的第二级降级源，同时为行程提供带出处的避坑/预约事实依据。
# 申请地址：https://cloud.siliconflow.cn （Embedding 与 Rerank 共用同一个 Key）
# 不填也能运行：检索链路会整体静默跳过，不影响行程生成。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 必须与建库时使用的模型一致，否则向量空间不匹配、检索失效
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=30

# ========== Google Maps（可选） ==========
GOOGLE_MAPS_API_KEY=
# 仅用于后端 Google Maps 服务，不影响 LLM、小红书、高德等请求。
GOOGLE_MAPS_PROXY=

# ========== 用户偏好记忆模块（可选） ==========
ENABLE_USER_MEMORY=false
MEMORY_THRESHOLD=2.0
MIN_INIT_WEIGHT=4.0
MEMORY_DECAY_FACTOR=0.97
MEMORY_MAX_RECALL=10
MEMORY_MAX_SINGLE_CONTENT=120
MEMORY_USE_SQLITE=false
