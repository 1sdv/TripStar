
# LLM配置（兼容 OpenAI 格式；也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL_ID 别名）
# 说明：LLM 客户端不会读取系统 HTTP(S)_PROXY，也不会使用 GOOGLE_MAPS_PROXY。
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# 小红书 Cookie
# 直接填浏览器请求头中的 Cookie 字符串，例如:
# XHS_COOKIE="ab=xxx; a1=xxx; webId=xxx"
# 也兼容浏览器导出的 JSON Cookie 列表/对象串，程序会自动转换。
XHS_COOKIE="这里填写您网页端登录小红书复制来的 Cookie"

# 高德地图 Web 服务 API Key（后端用于地理编码、POI、天气、路线等 REST 服务）
# 注意：前端 Web端(JS API) Key 与 Security JSCode 请配置在 frontend/.env.example 对应变量。
VITE_AMAP_WEB_KEY=your_amap_api_key_here

# Google Maps API 配置 (可选, 填写后优先使用 Google Maps，留空则使用高德)
# 需要在 Google Cloud Console 开启: Places API, Geocoding API, Routes API, Weather API
GOOGLE_MAPS_API_KEY=

# Google Maps 代理 (可选, 国内环境需要代理才能访问 Google API)
# 仅用于后端 Google Maps 服务；不会影响 LLM、小红书、高德等其它请求。
# 支持 HTTP/HTTPS 代理和 SOCKS5 代理，示例:
#   GOOGLE_MAPS_PROXY=http://127.0.0.1:7890
#   GOOGLE_MAPS_PROXY=socks5://127.0.0.1:1080
GOOGLE_MAPS_PROXY=

# ========== 用户偏好记忆模块 ==========
# 总开关（默认关闭，开启后才会注入记忆并提取偏好）
ENABLE_USER_MEMORY=false
# 遗忘阈值：权重衰减低于该值永久删除
MEMORY_THRESHOLD=2.0
# 入库准入门槛：LLM 偏好评分低于该值不存入
MIN_INIT_WEIGHT=4.0
# 每日权重衰减系数（0~1，越接近1遗忘越慢）
MEMORY_DECAY_FACTOR=0.97
# TOP-K：最多注入 Prompt 的记忆条数
MEMORY_MAX_RECALL=10
# 单条偏好最大字符长度
MEMORY_MAX_SINGLE_CONTENT=120
# true=SQLite 持久化（重启不丢失）；false=内存模式（重启丢失）
MEMORY_USE_SQLITE=false
