# 后端API地址（留空表示与前端同源）
VITE_API_BASE_URL=http://localhost:8000

# 高德地图Web API Key（后端地理编码使用，与 backend/.env 保持一致）
VITE_AMAP_WEB_KEY=your_amap_web_api_key_here
# 高德地图Web端JS API Key（必须是「Web端(JS API)」类型）
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here
# 高德 JS API 2.0 要求的安全密钥（控制台中与上面 JS Key 配套生成）
# 留空时高德会拒绝路线规划等服务插件，地图上的路线会退化成直线
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here
